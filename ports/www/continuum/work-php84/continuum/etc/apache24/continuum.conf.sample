# Continuum Apache vhost (sample — sanitize per deployment)
#
# TLS terminates upstream at the Hitch -> Varnish -> HAProxy (or ATS) layer.
# This vhost NEVER does TLS. It accepts PROXY protocol v2 on an alternate
# port so client IPs survive the front layer.
#
# Deploy: copy to the Apache Includes directory, substitute the hostnames
# and ServerAdmin address, ensure mod_remoteip is loaded.
#
# Requires: mod_remoteip (mod_remoteip.so) enabled.

# Local/direct access (health checks, admin, debugging)
<VirtualHost *:80>
    ServerAdmin webmaster@example.com
    DocumentRoot "/usr/local/www/continuum/public"
    DirectoryIndex index.php
    ServerName continuum.local

    Alias /mcp /usr/local/www/continuum/public/index.php
    Alias /health /usr/local/www/continuum/public/index.php
    Alias /metrics /usr/local/www/continuum/public/index.php

    <Directory "/usr/local/www/continuum/public">
        Require all granted
        AllowOverride None
    </Directory>

    ErrorLog "/var/log/continuum-error_log"
    CustomLog "/var/log/continuum-access_log" common
</VirtualHost>

# PROXY protocol v2 listener for the front-end stack
Listen 8089

<VirtualHost *:8089>
    ServerAdmin webmaster@example.com
    DocumentRoot "/usr/local/www/continuum/public"
    DirectoryIndex index.php
    ServerName continuum.example.com

    RemoteIPProxyProtocol On

    Alias /mcp /usr/local/www/continuum/public/index.php
    Alias /health /usr/local/www/continuum/public/index.php
    Alias /metrics /usr/local/www/continuum/public/index.php

    <Directory "/usr/local/www/continuum/public">
        Require all granted
        AllowOverride None
    </Directory>

    ErrorLog "/var/log/continuum-8089-error_log"
    CustomLog "/var/log/continuum-8089-access_log" common
</VirtualHost>
