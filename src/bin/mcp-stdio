#!/usr/bin/env php
<?php
/**
 * Continuum - stdio Transport Wrapper
 *
 * Allows the MCP server to be tested with the MCP Inspector
 * by providing stdin/stdout JSON-RPC transport.
 *
 * Usage:
 *   npx @modelcontextprotocol/inspector php bin/mcp-stdio
 */

chdir(__DIR__ . '/..');
require_once 'includes/bootstrap.inc.php';

use EnchiladaMCP\McpServer;
use Enchilada\Tortilla\ComalEventLoop;
use Enchilada\Tortilla\StdioTransport;
use Continuum\ServerTools;
use Continuum\BoardTools;
use Continuum\TaskTools;
use Continuum\LockTools;
use Continuum\ContextTools;
use Continuum\AgentTools;
use Continuum\MessageTools;
use Continuum\EventTools;
use Continuum\StatusTools;
use Continuum\MemoryTools;
use Continuum\BoardResources;
use Continuum\TaskResources;
use Continuum\AgentResources;
use Continuum\LockResources;
use Continuum\EventResources;
use Continuum\ContextResources;
use Continuum\CoordinationPrompts;
use Continuum\Storage\ContinuumStorage;
use Continuum\Bridge\HeliofaneMcpBridge;

// stdio has no transport auth; attribute everything to a fixed identity.
defined('CONTINUUM_AGENT') || define('CONTINUUM_AGENT', 'stdio');
// One stdio process is one session; scope presence by pid.
\Continuum\SessionContext::set('stdio-' . getmypid());

$server = new McpServer(APPLICATION_NAME, APPLICATION_VERSION);

$instructionsFile = APPLICATION_CONFDIR . 'instructions.txt';
if (file_exists($instructionsFile)) {
    $server->setInstructions(file_get_contents($instructionsFile));
}

$server->setTitle(APPLICATION_NAME)
    ->setDescription(APPLICATION_DESCRIPTION)
    ->setWebsiteUrl(APPLICATION_WEBSITE);

$server->register(new ServerTools());

global $SETTINGS;
$storage = ContinuumStorage::fromSettings($SETTINGS);
$storage->ensureSchema();
$server->register(new BoardTools($storage));
$server->register(new TaskTools($storage));
$server->register(new LockTools($storage));
$server->register(new ContextTools($storage));
$server->register(new AgentTools($storage));
$server->register(new MessageTools($storage));
$server->register(new EventTools($storage));
$server->register(new StatusTools($storage));

// Memory bridge is optional; promote_to_memory reports when unconfigured.
$heliofaneBridge = null;
$heliofaneUrl = trim($SETTINGS?->getString('heliofane', 'url', '') ?? '');
if ($heliofaneUrl !== '') {
    $heliofaneBridge = new HeliofaneMcpBridge(
        $heliofaneUrl,
        $SETTINGS->getString('heliofane', 'api_key', ''),
        $SETTINGS->getString('heliofane', 'mcp_path', 'mcp')
    );
}
if ($heliofaneBridge !== null) {
    $server->register(new MemoryTools($storage, $heliofaneBridge));
}

$server->register(new BoardResources($storage));
$server->register(new TaskResources($storage));
$server->register(new AgentResources($storage));
$server->register(new LockResources($storage));
$server->register(new EventResources($storage));
$server->register(new ContextResources($storage));
$server->register(new CoordinationPrompts($storage, $heliofaneBridge !== null));

// Run via StdioTransport: primitives in (handler, progress emitter),
// notifier back out. The loop is strict opt-in — with Comal not
// vendored here, ComalEventLoop::create() is null and the transport
// runs blocking I/O.
// A declared params._meta.session overrides the pid-scoped session as the
// targeting identity for inbox reads and task binding.
$handler = function (array $request) use ($server) {
    $declared = $request['params']['_meta']['session'] ?? null;
    \Continuum\SessionContext::setDeclared(is_string($declared) && $declared !== '' ? $declared : null);
    return $server->handleRequest($request);
};
$transport = new StdioTransport($handler, $server->tick(...));
$transport->setLogger(function (string $message) {
    fwrite(STDERR, "[MCP] " . $message . "\n");
});
if (($loop = ComalEventLoop::create()) !== null) {
    $transport->setLoop($loop);
}
$server->setNotifier($transport->sendNotification(...));
$transport->run();
