#!/usr/bin/env php
<?php
/**
 * Continuum smoke test — drives the real MCP wire against a live server.
 *
 * Covers: health, initialize, server/discover, tools/resources/prompts
 * listing, task lifecycle, board round-trip via both tools and resources,
 * event-log resource, completion, subscription stream (forked listener),
 * and MRTR cross-owner steal (prompt turn + inputResponses retry).
 *
 * Usage:
 *   php bin/smoke-test --url http://127.0.0.1:8090/mcp \
 *     --key <key-agent-1> [--key2 <key-agent-2>] [--timeout 10]
 *
 * Requires a second agent key (--key2) for the steal scenarios; without it
 * those checks are reported as SKIP. Enabled only against QA: the test
 * creates tasks/board entries named with a smoke marker (never deleted).
 *
 * Exit code 0 = all non-skipped checks passed.
 */

chdir(__DIR__ . '/..');

$options = getopt('', ['url:', 'key:', 'key2:', 'timeout::']);
$URL = rtrim($options['url'] ?? '', '/');
$KEY = $options['key'] ?? '';
$KEY2 = $options['key2'] ?? '';
$TIMEOUT = (int)($options['timeout'] ?? 10);

if ($URL === '' || $KEY === '') {
    fwrite(STDERR, "usage: smoke-test --url <mcp-url> --key <api key> [--key2 <second key>] [--timeout <s>]\n");
    exit(2);
}

$results = [];
function check(string $name, bool $ok, string $detail = ''): void {
    global $results;
    $results[] = [$name, $ok, $detail];
    echo ($ok ? 'PASS' : 'FAIL') . " {$name}" . ($detail ? " — {$detail}" : '') . "\n";
}
function skip(string $name, string $why): void {
    global $results;
    $results[] = [$name, null, $why];
    echo "SKIP {$name} — {$why}\n";
}

function httpPost(string $url, array $payload, string $key, array $headers = [], float $timeout = 10.0): array {
    $ch = curl_init($url);
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_POST => true,
        CURLOPT_POSTFIELDS => json_encode($payload),
        CURLOPT_HTTPHEADER => array_merge(['Content-Type: application/json', 'X-Api-Key: ' . $key], $headers),
        CURLOPT_TIMEOUT => (int)ceil($timeout),
    ]);
    $body = curl_exec($ch);
    $code = (int)curl_getinfo($ch, CURLINFO_RESPONSE_CODE);
    curl_close($ch);
    return [$code, is_string($body) ? json_decode($body, true) : null, (string)$body];
}

$rpcId = 0;
/** Legacy-era (handshake) request. */
function rpc(string $method, array $params, string $key, ?float $timeout = null): array {
    global $URL, $rpcId, $TIMEOUT;
    [, $data, $raw] = httpPost($URL, ['jsonrpc' => '2.0', 'id' => ++$rpcId, 'method' => $method, 'params' => $params], $key, ['Accept: application/json'], $timeout ?? $TIMEOUT);
    if (!is_array($data)) { return ['__parse_error' => $raw]; }
    return $data;
}

/** Modern-era request (2026-07-28): matching metadata headers required. */
function rpcModern(string $method, array $params, string $key, ?string $name = null, ?float $timeout = null): array {
    global $URL, $rpcId, $TIMEOUT;
    $params['_meta'] = array_merge([
        'io.modelcontextprotocol/protocolVersion' => '2026-07-28',
        'io.modelcontextprotocol/clientInfo' => ['name' => 'smoke-test', 'version' => '0.1'],
        'io.modelcontextprotocol/clientCapabilities' => ['elicitation' => (object)[]],
    ], $params['_meta'] ?? []);
    $headers = [
        'Accept: application/json',
        'MCP-Protocol-Version: 2026-07-28',
        'Mcp-Method: ' . $method,
    ];
    if ($name !== null) { $headers[] = 'Mcp-Name: ' . $name; }
    [, $data, $raw] = httpPost($URL, ['jsonrpc' => '2.0', 'id' => ++$rpcId, 'method' => $method, 'params' => $params], $key, $headers, $timeout ?? $TIMEOUT);
    if (!is_array($data)) { return ['__parse_error' => $raw]; }
    return $data;
}

$marker = 'smoke-' . bin2hex(random_bytes(4));

/** Structured body of a successful tools/call (all tools ship dual format). */
function toolData(array $resp): array {
    return $resp['result']['structuredContent'] ?? [];
}

// --- 1. health
$ch = curl_init(preg_replace('#/mcp$#', '/health', $URL));
curl_setopt_array($ch, [CURLOPT_RETURNTRANSFER => true, CURLOPT_TIMEOUT => $TIMEOUT]);
$body = curl_exec($ch);
$code = (int)curl_getinfo($ch, CURLINFO_RESPONSE_CODE);
curl_close($ch);
$health = is_string($body) ? json_decode($body, true) : null;
check('health probe', $code === 200 && ($health['status'] ?? '') === 'ok', "HTTP {$code}");

// --- 2. initialize (legacy era)
$init = rpc('initialize', ['protocolVersion' => '2025-11-25', 'capabilities' => ['elicitation' => new stdClass()], 'clientInfo' => ['name' => 'smoke-test', 'version' => '0.1']], $KEY);
$caps = $init['result']['capabilities'] ?? [];
check('initialize', isset($caps['tools'], $caps['resources'], $caps['prompts'], $caps['completions']), json_encode(array_keys($caps)));

// --- 3. server/discover (era probe works on any shape)
$discover = rpcModern('server/discover', [], $KEY);
check('server/discover lists modern revision', in_array('2026-07-28', $discover['result']['supportedVersions'] ?? [], true));

// --- 4. catalogs
$tools = array_column(rpc('tools/list', [], $KEY)['result']['tools'] ?? [], 'name');
check('tools/list has core tools', count(array_intersect(['task_create', 'task_claim', 'blackboard_write', 'advisory_lock_acquire', 'context_pack'], $tools)) === 5, count($tools) . ' tools');

$templates = array_column(rpc('resources/templates/list', [], $KEY)['result']['resourceTemplates'] ?? [], 'uriTemplate');
check('resource templates include board entry + context pack',
    in_array('continuum://board/{scope}/{key}', $templates, true) && in_array('continuum://context/pack/{scope}', $templates, true));

$prompts = array_column(rpc('prompts/list', [], $KEY)['result']['prompts'] ?? [], 'name');
check('prompts/list has the four coordination prompts', count(array_intersect(['session_bootstrap', 'claim_and_serve', 'handoff', 'milestone_sync'], $prompts)) === 4);

// --- 5. task lifecycle
$create = rpc('tools/call', ['name' => 'task_create', 'arguments' => ['title' => "Smoke task {$marker}", 'priority' => 3]], $KEY);
$taskId = toolData($create)['task'] ?? null;
check('task_create', is_string($taskId), (string)$taskId);
check('task_create text block is human-readable', str_contains($create['result']['content'][0]['text'] ?? '', "Smoke task {$marker}"));

if ($taskId !== null) {
    $card = rpc('resources/read', ['uri' => "continuum://tasks/{$taskId}"], $KEY);
    $cardBody = json_decode($card['result']['contents'][0]['text'] ?? '', true) ?? [];
    check('task card resource', ($cardBody['title'] ?? '') === "Smoke task {$marker}"
        && !empty($card['result']['contents'][0]['annotations']['lastModified']));

    $claim = rpc('tools/call', ['name' => 'task_claim', 'arguments' => ['taskId' => $taskId]], $KEY);
    check('task_claim', (toolData($claim)['status'] ?? '') === 'claimed');

    $completion = rpc('completion/complete', [
        'ref' => ['type' => 'ref/resource', 'uri' => 'continuum://tasks/{id}'],
        'argument' => ['name' => 'id', 'value' => strtoupper(substr((string)$taskId, 0, 3))],
    ], $KEY);
    check('completion suggests the new task id', in_array($taskId, $completion['result']['completion']['values'] ?? [], true));
}

// --- 6. board round-trip via tools + resources
$write = rpc('tools/call', ['name' => 'blackboard_write', 'arguments' => ['key' => $marker, 'value' => ['hi' => 'sailor']]], $KEY);
$read = rpc('resources/read', ['uri' => "continuum://board/global/{$marker}"], $KEY);
$readBody = json_decode($read['result']['contents'][0]['text'] ?? '', true) ?? [];
check('board write/read round-trip', empty($write['result']['isError']) && ($readBody['value']['hi'] ?? '') === 'sailor');

$snapshot = rpc('resources/read', ['uri' => 'continuum://snapshot/global'], $KEY);
check('snapshot resource contains the marker key', str_contains(
    $snapshot['result']['contents'][0]['text'] ?? '', '"' . $marker . '"'
));

// --- 7. event log resource reflects the writes
$since = rpc('resources/read', ['uri' => 'continuum://events/since/' . gmdate('Y-m-d\TH:i:s\Z', time() - 120)], $KEY);
$eventsText = $since['result']['contents'][0]['text'] ?? '';
check('event resource shows smoke activity', str_contains($eventsText, 'blackboard_write'));

// --- 8. prompts/get handoff for the created task
if ($taskId !== null) {
    $prompt = rpc('prompts/get', ['name' => 'handoff', 'arguments' => ['task_id' => $taskId]], $KEY);
    check('prompt handoff embeds task title', str_contains(
        $prompt['result']['messages'][0]['content']['text'] ?? '', "Smoke task {$marker}"
    ));
}

// --- 9. subscription stream: listen + forced write, verify notification
// A forked child collects frames; the parent re-writes the marker key
// (the exact URI the child subscribed to).
$subscribedUri = "continuum://board/global/{$marker}";
$readPipe = stream_socket_pair(STREAM_PF_UNIX, STREAM_SOCK_STREAM, STREAM_IPPROTO_IP);
$pid = pcntl_fork();
if ($pid === 0) {
    fclose($readPipe[0]);
    // child: stream the listen response with SSE framing
    $params = [
        'notifications' => ['resourceSubscriptions' => [$subscribedUri]],
        '_meta' => [
            'io.modelcontextprotocol/protocolVersion' => '2026-07-28',
            'io.modelcontextprotocol/clientInfo' => ['name' => 'smoke-test', 'version' => '0.1'],
            'io.modelcontextprotocol/clientCapabilities' => ['elicitation' => (object)[]],
        ],
    ];
    $w = $readPipe[1];
    $ch = curl_init($URL);
    curl_setopt_array($ch, [
        CURLOPT_POST => true,
        CURLOPT_POSTFIELDS => json_encode(['jsonrpc' => '2.0', 'id' => 500, 'method' => 'subscriptions/listen', 'params' => $params]),
        CURLOPT_HTTPHEADER => [
            'Content-Type: application/json',
            'Accept: text/event-stream',
            'X-Api-Key: ' . $KEY,
            'MCP-Protocol-Version: 2026-07-28',
            'Mcp-Method: subscriptions/listen',
        ],
        CURLOPT_TIMEOUT => 15,
    ]);
    curl_setopt($ch, CURLOPT_WRITEFUNCTION, function ($handle, $chunk) use ($w) {
        static $buffer = '';
        $buffer .= $chunk;
        while (($pos = strpos($buffer, "\n\n")) !== false) {
            $frame = substr($buffer, 0, $pos);
            $buffer = substr($buffer, $pos + 2);
            if (preg_match('/^data: (.*)$/m', $frame, $m)) {
                fwrite($w, $m[1] . "\n");
            }
        }
        return strlen($chunk);
    });
    curl_exec($ch); // runs until server close or curl timeout
    fclose($w);
    exit(0);
}
fclose($readPipe[1]);
usleep(800000); // let the child subscribe before we mutate
rpc('tools/call', ['name' => 'blackboard_write', 'arguments' => ['key' => $marker, 'value' => 'sub-test-update']], $KEY, $TIMEOUT);
$frames = '';
$deadline = microtime(true) + 20;
stream_set_blocking($readPipe[0], false);
while (microtime(true) < $deadline) {
    $chunk = stream_get_contents($readPipe[0]);
    if ($chunk !== false && $chunk !== '') { $frames .= $chunk; }
    if (str_contains($frames, 'resources/updated') && str_contains($frames, "board/global/{$marker}")) { break; }
    if (pcntl_waitpid($pid, $status, WNOHANG) === $pid) { $frames .= (string)stream_get_contents($readPipe[0]); break; }
    usleep(100000);
}
pcntl_waitpid($pid, $status);
fclose($readPipe[0]);
check('subscription stream notified on write',
    str_contains($frames, 'subscriptions/acknowledged') && str_contains($frames, 'resources/updated'),
    substr(json_encode(array_filter(explode("\n", $frames))), 0, 200)
);

// --- 10. MRTR cross-owner steal
if ($KEY2 === '') {
    skip('MRTR steal (modern elicitation)', 'no --key2 given');
    skip('MRTR decline keeps state', 'no --key2 given');
} else {
    $stealTarget = rpc('tools/call', ['name' => 'task_create', 'arguments' => ['title' => "Smoke steal {$marker}"]], $KEY2);
    $stealId = toolData($stealTarget)['task'] ?? null;
    if ($stealId === null) {
        skip('MRTR steal (modern elicitation)', 'second-key task_create failed');
        skip('MRTR decline keeps state', 'second-key task_create failed');
    } else {
        rpc('tools/call', ['name' => 'task_claim', 'arguments' => ['taskId' => $stealId]], $KEY2); // owned by agent 2

        $challenge = rpcModern('tools/call', ['name' => 'task_claim', 'arguments' => ['taskId' => $stealId]], $KEY, 'task_claim');
        $challengeResult = $challenge['result'] ?? [];
        check('MRTR steal challenge is input_required', ($challengeResult['resultType'] ?? '') === 'input_required'
            && isset($challengeResult['inputRequests']['confirm']));

        $retry = rpcModern('tools/call', [
            'name' => 'task_claim',
            'arguments' => ['taskId' => $stealId],
            'inputResponses' => ['confirm' => ['action' => 'accept', 'content' => ['approve' => true]]],
        ], $KEY, 'task_claim');
        check('MRTR steal approved transfers ownership', (toolData($retry)['status'] ?? '') === 'claimed');

        $decline = rpcModern('tools/call', [
            'name' => 'task_claim',
            'arguments' => ['taskId' => $stealId],
            'inputResponses' => ['confirm' => ['action' => 'decline', 'content' => []]],
        ], $KEY2, 'task_claim'); // agent 2 tries to steal back but declines
        $declineBody = $decline['result'] ?? [];
        check('MRTR decline keeps state', !empty($declineBody['isError'])
            && str_contains($declineBody['content'][0]['text'] ?? '', 'steal declined'));

        // legacy-era client gets the tool-error path, not input_required
        $legacy = rpc('tools/call', ['name' => 'task_claim', 'arguments' => ['taskId' => $stealId]], $KEY2);
        $legacyResult = $legacy['result'] ?? [];
        check('legacy client sees confirmation tool-error', !empty($legacyResult['isError'])
            && str_contains($legacyResult['content'][0]['text'] ?? '', "'confirm'"));
    }
}

// --- summary
$failed = 0; $skipped = 0;
foreach ($results as [, $ok]) {
    if ($ok === false) { $failed++; } elseif ($ok === null) { $skipped++; }
}
echo "---\n" . count($results) . " checks, {$failed} failed, {$skipped} skipped\n";
exit($failed === 0 ? 0 : 1);
