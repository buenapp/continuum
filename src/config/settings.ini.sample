; Continuum MCP Server configuration
; Copy to settings.ini and adjust values

; Per-agent API keys. Presented as "X-Api-Key: <key>" or
; "Authorization: Bearer <key>". The array key is the agent identity used
; for capability scoping and the audit event log.
[agents]
;devin    = "replace-with-long-random-key"
;windsurf = "replace-with-long-random-key"

[server]
debug = false
; Browser Origin allow-list (MCP DNS-rebinding defense). Non-browser MCP
; clients (Devin, Windsurf, mcp-bridge) send no Origin and are unaffected.
;allowed_origins = https://example.com

; Ephemeral engine: coordination, locks, queues, signals (ValKey, RESP)
[valkey]
;host = 127.0.0.1
;port = 6379

; Durable engine: plans, resume prompts, workflow snapshots, event log (CouchDB)
[couchdb]
;host = 127.0.0.1
;port = 5984
;user = admin
;pass = ""
;database_prefix = continuum_

; Structural engine: task dependency graph, agent relationships (ArcadeDB)
[arcadedb]
;host = 127.0.0.1
;port = 2480
;user = root
;pass = ""
;database = continuum

; Optional semantic ranking for context_pack (llama.cpp/OpenAI-compatible
; embeddings endpoint). Without it, context_pack falls back to lexical
; ranking when a query is given.
[embeddings]
;url = https://embeddings.example.com
;model = all-MiniLM-L6-v2
;api_key = ""

; Long-term memory bridge (Heliofane MCP server) for promote_to_memory
[heliofane]
;url = https://heliofane.example.com
;api_key = ""
;mcp_path = mcp

; Milestone sync to an external work tracker. Only 'none' ships; the
; adapter interface is the seam for future Phorge/Conduit integration.
; NOTE: bare 'none'/true/false/yes/no parse as booleans — quote it.
[milestones]
;adapter = "none"

; XMPP transport (issue #3), strictly optional. When a bridge sidecar runs,
; its inbound hook (POST /mcp/xmpp-inbound) must authenticate as the agent
; named here; without this section the hook rejects everything.
;[xmpp]
;bridge_agent = continuum-xmpp-bridge
;
; Outbound: when socket + domain are set, message_send/broadcast travel over
; XMPP via the sidecar instead of local inbox delivery. The agent's JID is
; <identity>@<domain>; a session target becomes the JID resource.
;socket = /var/run/continuum-xmpp-bridge.sock
;domain = xmpp.example.com
