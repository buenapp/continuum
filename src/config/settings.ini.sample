; Continuum MCP Server configuration
; Copy to settings.ini and adjust values

; Per-agent API keys. Presented as "X-Api-Key: <key>" or
; "Authorization: Bearer <key>". The array key is the agent identity used
; for capability scoping and the audit event log.
[agents]
;devin    = "replace-with-long-random-key"
;windsurf = "replace-with-long-random-key"

[server]
debug = false
; Browser Origin allow-list (MCP DNS-rebinding defense). Non-browser MCP
; clients (Devin, Windsurf, mcp-bridge) send no Origin and are unaffected.
;allowed_origins = https://example.com

; Ephemeral engine: coordination, locks, queues, signals (ValKey, RESP)
[valkey]
;host = 127.0.0.1
;port = 6379

; Durable engine: plans, resume prompts, workflow snapshots, event log (CouchDB)
[couchdb]
;host = 127.0.0.1
;port = 5984
;user = admin
;pass = ""
;database_prefix = continuum_

; Structural engine: task dependency graph, agent relationships (ArcadeDB)
[arcadedb]
;host = 127.0.0.1
;port = 2480
;user = root
;pass = ""
;database = continuum

; Optional semantic ranking for context_pack (llama.cpp/OpenAI-compatible
; embeddings endpoint). Without it, context_pack falls back to lexical
; ranking when a query is given.
[embeddings]
;url = https://embeddings.example.com
;model = all-MiniLM-L6-v2
;api_key = ""

; Long-term memory bridge (Heliofane MCP server) for promote_to_memory
[heliofane]
;url = https://heliofane.example.com
;api_key = ""
;mcp_path = mcp

; Milestone sync to an external work tracker. Only 'none' ships; the
; adapter interface is the seam for future Phorge/Conduit integration.
; NOTE: bare 'none'/true/false/yes/no parse as booleans — quote it.
[milestones]
;adapter = "none"

; Verifiable sender identity (issue #6, docs/IDENTITY.md). When
; sign_key_file is set, every message_send attaches `attest`: an
; Ed25519 signature over the canonical envelope encoding plus the
; authenticated workstream. The file holds raw sodium Ed25519 key
; material (a 64-byte secret key or a full 96-byte keypair in
; sodium_crypto_sign_keypair format); publish the matching public key
; in the identity registry as workstream `continuum`. Unset = no
; attestation and sends behave exactly as before.
[identity]
;sign_key_file = /var/db/continuum/sign.key

; OTLP request telemetry (0.5.0): one fire-and-forget structured log
; record per MCP request, sent to the central collector by default when
; enabled. Failures never affect request handling. Disable by leaving out.
;[otlp]
;enabled = true
;endpoint = "http://telemetry.morante.com"
;environment = "prod"

; XMPP transport (issue #3), strictly optional. When a bridge sidecar runs,
; its inbound hook (POST /mcp/xmpp-inbound) must authenticate as the agent
; named here; without this section the hook rejects everything.
;[xmpp]
;bridge_agent = continuum-xmpp-bridge
;
; Outbound: when socket + domain are set, message_send/broadcast travel over
; XMPP via the sidecar instead of local inbox delivery. Targets are the bare
; JID <identity>@<domain>; a session target rides in the sonya payload.
;socket = /var/run/continuum-xmpp-bridge.sock
;domain = xmpp.example.com

; Direct session injection (issue #13), strictly optional and operator-owned.
; message_send(..., preemption: wakeup|steer|interrupt) attaches a receiver
; policy request. The durable inbox is written once on every send; configured
; XMPP adds real-time delivery and direct injection is supplemental. See
; docs/DIRECT-INJECTION.md for the full receiver-policy and delivery contract.
[injection]
;enabled = true
; timeout is the TOTAL liveness-plus-injection budget, not a per-HTTP-call budget.
;timeout = 5
; Agent IDs whose native Sonya-style policy handles preemption (no direct target).
;native_receivers = "sonya"
;
; OpenCode 2.0.x (top-level text payload). Use payload="nested" for the
; prompt:{text:...} variant, or payload="parts" for the legacy API.
; transport="rest" plus driver="opencode" is an equivalent declaration.
;[injection.opencode]
;transport = "opencode"
;driver = "opencode"
;base_url = "http://127.0.0.1:4555"
;payload = "text"
;auth_scheme = "basic"
;username = "opencode"
;credential_file = "/var/db/continuum/opencode.password"
;session_resolution = "message"
;session_id = ""
;session_map = "{}"
;ca_file = ""
;timeout = 5
; Sender allowlists are deny-by-default. interrupt requires kind=control and
; require_signed defaults to true for interrupt, false for wakeup/steer.
;wakeup_from = "devin,opencode"
;steer_from = "devin,opencode"
;interrupt_from = "sonya"
;require_signed = true
;
; OpenHands agent-server. header auth defaults to X-Session-API-Key.
;[injection.openhands]
;transport = "openhands"
;base_url = "http://127.0.0.1:18000"
;auth_scheme = "header"
;auth_header = "X-Session-API-Key"
;credential_file = "/var/db/continuum/openhands.key"
;session_resolution = "map"
;session_map = '{"continuum-session-id":"openhands-conversation-id"}'
;session_id = ""
;ca_file = ""
;timeout = 5
;wakeup_from = "devin,opencode"
;steer_from = "devin,opencode"
;interrupt_from = "sonya"
;require_signed = true
;
; Custom JSON-lines agent. transport="tcp" (or "tcp-json"); scheme="tls"
; enables verified TLS. See docs/DIRECT-INJECTION.md for the atomic contract.
;[injection.custom]
;transport = "tcp"
;host = "127.0.0.1"
;port = 45432
;scheme = "tcp"
;session_resolution = "message"
;session_id = ""
;session_map = "{}"
;ca_file = ""
;timeout = 5
;wakeup_from = "devin,opencode"
;steer_from = "devin,opencode"
;interrupt_from = "sonya"
;require_signed = true
;
; auth_scheme also accepts "none", "bearer", or "header" on REST targets.
; ACP/stdio is reserved for a future topology; XMPP stays under [xmpp].
; Plain HTTP and CA-validated HTTPS/TLS are supported for this change.
; DANE TLSA-first support is a separate future Extras integration.
